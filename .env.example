# ContextFS 本地环境变量示例：复制为 .env 并按需修改（.env 不入库）

# 服务
SERVER_PORT=8080

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/contextfs
POSTGRES_USERNAME=contextfs
POSTGRES_PASSWORD=contextfs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Milvus
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DIMENSION=1024
MILVUS_COLLECTION=ctxfs_chunks

# LLM（L0/L1 摘要生成，OpenAI 兼容接口）
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding（三层内容向量化，维度需与 MILVUS_DIMENSION 一致）
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 缓存与生成
CACHE_READ_TTL=PT10M
LEVELS_ASYNC=true

# 记忆管线
CONTEXTFS_MEMORY_ENABLED=true
MEMORY_ASYNC=true

# 可观测：traceId 贯穿（X-ContextFS-Trace-Id 头），retrieval_log / tool_call_log / trace_span
# OTLP 导出预留（本地无 collector 时无需启用）
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
