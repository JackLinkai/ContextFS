# ContextFS 本地环境变量示例：复制为 .env 并按需修改（.env 不入库）

# 服务
SERVER_PORT=8080

# PostgreSQL
POSTGRES_URL=jdbc:postgresql://localhost:5432/contextfs
POSTGRES_USERNAME=contextfs
POSTGRES_PASSWORD=contextfs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ctxfs_chunks

# LLM（阶段 4 接入，OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Embedding（阶段 4 接入）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ContextFS
CONTEXTFS_MEMORY_ENABLED=true
